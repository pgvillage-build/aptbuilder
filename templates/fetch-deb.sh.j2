#!/usr/bin/env bash
#
# Download the prebuilt {{ package_name }} {{ version }} .deb for the distro of this system.
#
# Generated from a Jinja2 template; do not edit the rendered script by hand.
#
# {{ organization }}/{{ repository }} builds a deb per distro with revision 1~<ID><VERSION_ID> (from
# /etc/os-release). GitHub replaces the ~ with a . in release asset names, so the asset is named
# e.g. {{ package_name }}_<version>-1.ubuntu24.04_{{ binary_arch }}.deb.
# Distros it does not build for are skipped with a warning.
#
# Usage: ./build-{{ package_name }}-{{ binary_arch }}-deb.sh
#   OUT_DIR  directory to write the .deb to (default: ./dist)

set -euo pipefail

OUT_DIR="${OUT_DIR:-$(pwd)/dist}"
# shellcheck disable=SC1091
DIST="$(. /etc/os-release && echo "${ID}${VERSION_ID}")"

# <asset name> <url>
ASSETS=(
{% for asset in assets %}  "{{ asset.name }} {{ asset.url }}"
{% endfor %})

for ASSET in "${ASSETS[@]}"; do
  NAME="${ASSET%% *}"
  URL="${ASSET#* }"
  [[ "${NAME}" == *".${DIST}_"*.deb ]] || continue
  echo "Downloading ${URL}"
  mkdir -p "${OUT_DIR}"
  curl -fsSL --retry 3 -o "${OUT_DIR}/${NAME}" "${URL}"
  echo "Downloaded ${OUT_DIR}/${NAME}"
  exit 0
done

echo "WARNING: {{ organization }}/{{ repository }} {{ version }} has no {{ package_name }} deb for ${DIST}, skipping" >&2
