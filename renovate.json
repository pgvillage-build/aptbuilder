{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["before 6am on monday"],
  "semanticCommits": "enabled",
  "labels": ["dependencies"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Versions pinned in config/github2deb.yaml: the key below a renovate comment (target_release, go_version)",
      "managerFilePatterns": ["/^config/github2deb\\.yaml$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+versioning=(?<versioning>\\S+))?\\s*\\n\\s*[a-z_]+:\\s*(?:tags/)?(?<currentValue>\\S+)"
      ]
    }
  ]
}
